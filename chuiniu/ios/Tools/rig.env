# Drive THE rig at foolish/ios/Tools/rig against Chui Niu (pickemup/ios/Tools/rig.env's shape).
#
#   source chuiniu/ios/Tools/rig.env
#   export RIG_SIM=<udid>
#   foolish/ios/Tools/rig/rig.sh open        # the + menu, then Chui Niu's drawer
#
# `rig.sh build` runs `make ios-lib` first, so until the kernel is linked build
# and install by hand (README "Build") and use the rig only to open and shoot.
# EVERY PATH FROM THIS FILE'S OWN LOCATION, so a worktree drives its own tree.
_cn_env="${BASH_SOURCE[0]:-${(%):-%x}}"
_cn_ios="$(cd "$(dirname "$_cn_env")/.." && pwd)"
export RIG_APP_ID=cards.chuiniu
export RIG_EXT_DOM=cards.chuiniu.msg
export RIG_APP_GROUP=group.cards.chuiniu
export RIG_SCHEME=ChuiniuMessagesApp
export RIG_XCPROJ="$_cn_ios/Chuiniu.xcodeproj"
export RIG_APP_BUNDLE=ChuiniuMessagesApp.app
export RIG_APPEX=ChuiniuMessages
export RIG_MENU_NAME="Chui Niu"
export RIG_LOG_SUBSYSTEM=cards.chuiniu
export RIG_KERNEL_DIR="$_cn_ios/../c"
export RIG_IOS_DIR="$_cn_ios"
export RIG_SEEDER=
unset _cn_env _cn_ios

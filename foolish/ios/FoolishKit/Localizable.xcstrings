{
  "sourceLanguage": "en",
  "strings": {
    "about": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О нас"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소개"
          }
        }
      }
    },
    "about_foolish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About FOOLISH"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О ДУРАЦКИЙ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FOOLISH 소개"
          }
        }
      }
    },
    "about_paragraph_1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a classic Russian card game known as дурак. I brought this game to school years ago. My parents taught me one version. But what I taught to my classmates got a bit muddled up. The game evolved a bit as we played at lunch, usually with 8 players at a time. As a result, the core rules still stand but with a few chaotic changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_translation",
            "value": "This is a classic Russian card game known as дурак. I brought this game to school years ago. My parents taught me one version. But what I taught to my classmates got a bit muddled up. The game evolved a bit as we played at lunch, usually with 8 players at a time. As a result, the core rules still stand but with a few chaotic changes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_translation",
            "value": "This is a classic Russian card game known as дурак. I brought this game to school years ago. My parents taught me one version. But what I taught to my classmates got a bit muddled up. The game evolved a bit as we played at lunch, usually with 8 players at a time. As a result, the core rules still stand but with a few chaotic changes."
          }
        }
      }
    },
    "about_paragraph_2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passing (Переводная) is always enabled. When throwing in attacks, it's first come first serve as to who gets the card in. And when attacking, you can put down as many cards as the defender has even if it's more than 6. You can imagine this gets very crazy and very fun with 8 players. It adds an element of fast decision making. Go big or go home. I call this American Fool. Hence the website name Foolish."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_translation",
            "value": "Passing (Переводная) is always enabled. When throwing in attacks, it's first come first serve as to who gets the card in. And when attacking, you can put down as many cards as the defender has even if it's more than 6. You can imagine this gets very crazy and very fun with 8 players. It adds an element of fast decision making. Go big or go home. I call this American Fool. Hence the website name Foolish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_translation",
            "value": "Passing (Переводная) is always enabled. When throwing in attacks, it's first come first serve as to who gets the card in. And when attacking, you can put down as many cards as the defender has even if it's more than 6. You can imagine this gets very crazy and very fun with 8 players. It adds an element of fast decision making. Go big or go home. I call this American Fool. Hence the website name Foolish."
          }
        }
      }
    },
    "about_paragraph_3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What started as a simple project to play the game with friends across the world turned into a lot of learning for me. This has game AIs, optimistic animations with reverts, and workarounds for the limits of Supabase's free tier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_translation",
            "value": "What started as a simple project to play the game with friends across the world turned into a lot of learning for me. This has game AIs, optimistic animations with reverts, and workarounds for the limits of Supabase's free tier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_translation",
            "value": "What started as a simple project to play the game with friends across the world turned into a lot of learning for me. This has game AIs, optimistic animations with reverts, and workarounds for the limits of Supabase's free tier."
          }
        }
      }
    },

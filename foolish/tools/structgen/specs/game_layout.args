# structgen arguments for sdk/ts/gen/game_layout.<build>.ts, and for the
# SG_LAYOUT_HASH c/Makefile bakes into each wasm module (wasm_layout_hash).
# Read by tools/structgen/gen.sh and c/Makefile, both with --cwd c/ and the
# build's own flags, so the module and the wasm hash come from ONE argument list.
# Lines starting with # are dropped; everything else is split on whitespace.
#
# The resident Game prefix the TS marshal reads and writes.
--header game.h --root Game
--fields Game=status,num_players,power_suit,first_attacker,defender,num_battles,deck_count,discard_pile_length,has_flipped,deterministic_deck,flipped,deck,table_battles,players,elimination_order,num_eliminated,good_players_mask,has_good_timestamp,rules
--fields Player=status,hand_count,awaiting_attack,strategy_key,hand
--const GAME_STATUS_ --const PLAYER_STATUS_ --const GAME_RULE_
--const FOOLISH_SEED_LEN
#
# The C Table (c/src/table.h): what the server reads back from bots.wasm - the
# loaded roster, a commit's spans and scalars, a decoded action request, the
# finish order and rating changes - and the result codes it maps. Part of the
# same hash, so a module and these readers cannot disagree about any of it.
--header table.h --root Roster --root TableCommit --root TableRequest --root TableElo
# A finished fixture's rating stamp (view.h), which e2e/helpers/table_fixture.ts writes.
--header view.h --root GameRatings --const ENV_ISLAND_
# The test entries' shapes (roster.h): a table as a test states it, and what
# reading an envelope trailer said - e2e/helpers/roster_kernel.ts writes the one
# and reads the other through these.
--header roster.h --root RosterSpec --root RosterTrailerRead
--writer RosterSpec --snapshot RosterSpec --snapshot RosterTrailerRead
--count RosterSpec.seats=n --count RosterSpec.title=title_len --count RosterTrailerRead.gid=gid_len
--count RosterSpecSeat.id=id_len --count RosterSpecSeat.name=name_len --count RosterSpecSeat.brain=brain_len
--const TABLE_ --const ENGINE_REJECT_ --const GAME_INVALID_ --const ROSTER_E_
#
# The web client's slot (client_table.h): hashed here so a stale
# view_layout.bots.ts (specs/view_layout.args) is a load-time error too.
--header client_table.h --root TableView --root PushEvent --root ViewRules --root BoardEdit --root ClientConflict
--root PushSettle
--header replay_steps.h --root ReplaySummary --root ReplayFrameIndex
#
# A code's decoded log stream, record by record (replay.h, the test build's
# wasm_replay_decoded_next): its log types and the codec's result codes.
--header replay.h --root ReplayDecodedLog --root ReplayError
--const LOG_ --const REPLAY_E
#
# The bot cycle the table drives (bot_drive.h): what a server logs of it, and
# what a bot search saw of the session log (BeliefProbe, test observability).
--header bot_drive.h --root BotDriveOut --root BeliefProbe
--fields LegalMove=type,n_cards,cards,attack_cards
--const BOT_STOP_ --const BOT_PACE_ --const MOVE_
#
# Test fixtures (e2e/helpers/table_fixture.ts): card notation refusals and suit
# numbers (card.h), and the durable roster's length a sealed row carries.
--const CARD_PARSE_E_ --const SUIT_ --const ROSTER_BYTES
#
# The replay code's extras (replay_extras.h ReplayExtras): the seat nicknames and
# per-move timing a share link carries, as the struct the bridge crosses with.
# Its reader and writer are generated into msg_layout.bots.ts (the browser reads
# links too); the root is here for the load-time hash.
--header replay_extras.h --root ReplayExtras
# The hand's shape (view_layout.args reads and writes these), so the layout hash
# bots.wasm is checked against covers HandMetrics and HandLayout too.
--header hand_layout.h --root HandMetrics --root HandLayout
# One step of the stream a plan is asked for (view_layout.args writes it), so the
# layout hash bots.wasm is checked against covers ClientPlanStep too.
--root ClientPlanStep
# The animation core's four small questions (view_layout.args reads and writes
# them), so the layout hash bots.wasm is checked against covers them too.
--header anim_plan.h --root AnimStaleAsk --root AnimStaleRelease --root AnimReversalAsk --root AnimConflictPlan
--root AnimHandAsk --root AnimHandLaid --root AnimFinishAsk --root AnimFinish
# The move a client sends (view_layout.args writes it), so the layout hash
# covers ClientMove too.
--header client_table.h --root ClientMove
# The action response a client reads (view_layout.args), for the hash.
--header table.h --root TableResponse
#
# An ask (ask.h): every request that is not a move, as the server reads the one
# a body decoded to, and the refusal it answers with. view_layout.args holds the
# client's writer and readers; the roots are here so the load-time hash covers both.
--header ask.h --root TableAsk --root AskRefusal
--snapshot TableAsk
--count TableAsk.gid=gid_len --count TableAsk.bot=bot_len --count TableAsk.player=player_len
--count TableAsk.idx=n_idx --count TableAsk.order=n_order --count TableAsk.title=title_len
--count AskId.id=len
--const ASK_
--header bot_roster.h --root BotRosterTable
--header replay_steps.h --root ReplayStep
--root ReplayPlayStep
--header anim_plan.h --root AnimRoles
# The backend's client (netclient.h): what net_layout.bots.ts reads.
--header netclient.h --root NcRequest --root NcSessionInfo --root NcError --root NcGameRow --root NcAction --root NcEvent --root NcOut
--root NcChatRow --root NcBotRow --root NcBoardRow --root NcHistoryRow --root NcHistoryHead --root NcReplay

# structgen arguments for sdk/ts/gen/view_layout.bots.ts: the web client's
# reader of its slot (c/src/client_table.h). Snapshot readers only - plain
# objects copied out of the module, no accessor over the struct - and the
# constants a view is read with. Read by tools/structgen/gen.sh with --cwd c/
# and the bots build's flags. The same roots are in game_layout.args, so the
# layout hash web.wasm is checked against at load covers these readers too.
# Lines starting with # are dropped; everything else is split on whitespace.
--header client_table.h --header legal.h --header evwire.h --header anim_plan.h --header replay_steps.h --root TableView --root PushEvent --root ViewRules
--root ReplaySummary --snapshot ReplaySummary --count ReplaySummary.elimination=num_eliminated
# Where one chunk of replay frames lies (replay_steps.h ReplayFrameIndex): the
# counts keep a snapshot to the frames this chunk actually holds.
--root ReplayFrameIndex --snapshot ReplayFrameIndex
--count ReplayFrameIndex.off=n --count ReplayFrameIndex.len=n
# Why a replay call refused (replay.h ReplayError), for the message the web and
# the server word from it; in this module because the browser reads codes too.
--header replay.h --root ReplayError --snapshot ReplayError --const LOG_
--root BoardEdit --root ClientConflict
# What a push does to my unanswered moves (client_table.h client_push_settle):
# the fates, the events already played and the return flights, through its reader.
--root PushSettle --snapshot PushSettle
--count PushSettle.played=n_events --count PushSettle.fates=n_motions
--count PushSettle.flight_count=n_flights --count PushSettle.order=n_order
# What a gesture on a board means (client_table.h client_play, legal.h play_*).
# The gesture goes in through its writer and the answer comes back through its
# reader, so no host packs a menu byte, a table byte or a card byte by hand.
--root ClientGesture --root ClientPlay --snapshot ClientGesture --snapshot ClientPlay --writer ClientGesture
--count ClientGesture.cards=n_cards --count ClientPlay.cards=n_cards
--count ClientPlay.attack_cards=n_cards --count ClientPlay.coverable=n_coverable
--const PLAY_TARGET_ --const MOVE_ --const PLAY_HOST_ --const PLAY_PILL_
--snapshot TableView --snapshot PushEvent --snapshot ViewRules --snapshot BoardEdit --snapshot ClientConflict --writer TableView --snapshot-only
--writer BoardEdit --writer ClientConflict
--count BoardEdit.cards=n_cards --count ClientConflict.events=n_events --count ClientConflict.motions=n_motions
--count ConflictEvent.cards=n_cards
--count TableView.battles=num_battles --count TableView.seats=num_players
--count TableView.my_hand=my_hand_count --count TableView.elimination=num_eliminated
--count TableView.game_id=gid_len --count TableView.title=title_len
--count ViewSeat.id=id_len --count ViewSeat.name=name_len --count PushEvent.cards=n_cards
--const GAME_STATUS_ --const PLAYER_STATUS_ --const EVW_T_ --const EVW_LOC_ --const EVW_MSG_ --const CLIENT_ --const CARD_NONE_ --const ANIM_DEST_ --const ANIM_CONFLICT_ --const ANIM_EVT_
# The shape of my hand (hand_layout.h hand_layout): the metrics go in through
# their writer, the rows and every slot come back through the layout's reader,
# so the web places each card at the kernel's slot with no offset of its own.
--header hand_layout.h --root HandMetrics --root HandLayout
--writer HandMetrics --snapshot HandMetrics --snapshot HandLayout
--count HandLayout.slot=n --const HAND_
# One step of the stream a plan is asked for (client_table.h client_plan_step):
# what moved goes in through its writer, and the board it left through
# TableView's. The plan itself is read where it lies (anim.bots.ts).
--root ClientPlanStep --writer ClientPlanStep --snapshot ClientPlanStep
--count ClientPlanStep.cards=n_cards
--const MAX_PLAYERS
# Four small questions of the animation core, asked as values (anim_plan.h):
# which optimistic cards a broadcast releases, the order a doomed sequence flies
# home in, the order a hand is drawn in, and the end screen's rows. Each ask
# goes in through its writer and each answer comes back through its reader, so
# sdk/ts/wasm/bots.ts packs no card byte and reads no offset for them.
--root AnimStaleAsk --root AnimStaleRelease --writer AnimStaleAsk --snapshot AnimStaleAsk --snapshot AnimStaleRelease
--count AnimStaleAsk.opt=n_opt --count AnimStaleAsk.table=n_table --count AnimStaleAsk.named=n_named --count AnimStaleRelease.release=n
--root AnimReversalAsk --root AnimConflictPlan --writer AnimReversalAsk --snapshot AnimReversalAsk --snapshot AnimConflictPlan
--count AnimReversalAsk.verdicts=n_motions --count AnimReversalAsk.group_sizes=n_groups
--count AnimConflictPlan.verdicts=n_verdicts --count AnimConflictPlan.step_count=n_steps --count AnimConflictPlan.order=n_order
--root AnimHandAsk --root AnimHandLaid --writer AnimHandAsk --snapshot AnimHandAsk --snapshot AnimHandLaid
--count AnimHandAsk.cards=n_cards --count AnimHandAsk.order=n_order --count AnimHandLaid.cards=n
--root AnimFinishAsk --root AnimFinish --writer AnimFinishAsk --snapshot AnimFinishAsk --snapshot AnimFinish
--count AnimFinishAsk.elimination=n_elim --count AnimFinish.rows=n
# The move a client sends (client_table.h ClientMove, awire.h): it goes in
# through its writer and the kernel writes the action wire, so no host packs a
# frame or a card byte. AWIRE_* are the kinds and the frame's card capacity.
--root ClientMove --snapshot ClientMove --writer ClientMove
--count ClientMove.cards=n_cards --count ClientMove.attack_cards=n_attacks
--header awire.h --const AWIRE_
# The `action` endpoint's answer as a client reads it (table.h TableResponse,
# table_response_decode), with the statuses and the one policy code it carries.
--header table.h --root TableResponse --snapshot TableResponse
--const TABLE_STATUS_ --const TABLE_REJECT_STALE_ROUND
# An ask (ask.h): every request that is not a move goes in through its writer and
# the kernel writes the body; a refusal comes back through its reader. No host
# spells a field name or packs a byte of either.
--header ask.h --root TableAsk --root AskRefusal
--snapshot TableAsk --writer TableAsk --snapshot AskRefusal
--count TableAsk.gid=gid_len --count TableAsk.bot=bot_len --count TableAsk.player=player_len
--count TableAsk.idx=n_idx --count TableAsk.order=n_order --count TableAsk.title=title_len
--count AskId.id=len
--const ASK_
# The cast header (evwire.h): how many bytes of a realtime payload stand before the as3 push.
--const EVW_CAST_
# The bot roster as a value (bot_roster.h BotRosterTable): what the kernel's one
# table says about every named bot and what this build links, through its reader.
--header bot_roster.h --root BotRosterTable --snapshot BotRosterTable
--count BotRosterTable.rows=n --count BotRosterRow.key=key_len
# One step as a replay screen plays it (replay_steps.h ReplayPlayStep), read where
# the records lie, RS_PLAY_STRIDE bytes apart.
--root ReplayPlayStep --snapshot ReplayPlayStep
# The marks a role beat shows next (anim_plan.h AnimRoles): the three role
# entries answer with its address, so the bridge reads no byte of it.
--root AnimRoles --snapshot AnimRoles

for this format.\n  throw new ERR_IMPORT_ATTRIBUTE_TYPE_INCOMPATIBLE(url\x2C type);\n}\n\n\nmodule.exports = {\n  kImplicitTypeAttribute\x2C\n  validateAttributes\x2C\n};\n

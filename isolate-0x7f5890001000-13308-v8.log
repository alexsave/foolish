t err = new TypeError(message);\n  ObjectAssign(err\x2C errorProperties);\n  return err;\n}\n\nfunction makeException(message\x2C opts = kEmptyObject) {\n  const prefix = opts.prefix ? opts.prefix + ': ' : '';\n  const context = opts.context?.length === 0 ?\n    '' : (opts.context ?? 'Value') + ' ';\n  return codedTypeError(\n    `${prefix}${context}${message}`\x2C\n    { code: opts.code || 'ERR_INVALID_ARG_TYPE' }\x2C\n  );\n}\n\nfunction createEnumConverter(name\x2C values) {\n  const E = new SafeSet(values);\n\n  return function(V\x2C opts = kEmptyObject) {\n    const S = String(V);\n\n    if (!E.has(S)) {\n      throw makeException(\n        `value '${S}' is not a valid enum value of type ${name}.`\x2C\n        { __proto__: null\x2C ...opts\x2C code: 'ERR_INVALID_ARG_VALUE' });\n    }\n\n    return S;\n  };\n}\n\n// https://tc39.es/ecma262/#sec-ecmascript-data-types-and-values\nfunction type(V) {\n  switch (typeof V) {\n    case 'undefined':\n      return UNDEFINED;\n    case 'boolean':\n      return BOOLEAN;\n    case 'number':\n      return NUMBER;\n    case 'string':\n      return STRING;\n    case 'symbol':\n      return SYMBOL;\n    case 'bigint':\n      return BIGINT;\n    case 'object': // Fall through\n    case 'function': // Fall through\n    default:\n      if (V === null) {\n        return NULL;\n      }\n      // Per ES spec\x2C typeof returns an implementation-defined value that is not\n      // any of the existing ones for uncallable non-standard exotic objects.\n      // Yet Type() which the Web IDL spec depends on returns Object for such\n      // cases. So treat the default case as an object.\n      return OBJECT;\n  }\n}\n\n// https://webidl.spec.whatwg.org/#js-dictionary\nfunction createDictionaryConverter(members) {\n  // The spec requires us to operate the members of a dictionary in\n  // lexicographical order. We are doing this in the outer scope to\n  // reduce the overhead that could happen in the returned function.\n  const sortedMembers
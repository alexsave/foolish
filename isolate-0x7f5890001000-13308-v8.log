:\n    case 'module-typescript':\n    case 'commonjs-typescript':\n    case 'typescript': {\n      decoder ??= new (require('internal/encoding').TextDecoder)();\n      result.source = decoder.decode(source);\n      break;\n    }\n    default:\n      break;\n  }\n  return result;\n}\n\n/**\n * Resolve module request to a url\x2C through a hooks chain if it exists.\n * @param {string} specifier\n * @param {string|undefined} parentURL\n * @param {ImportAttributes|undefined} importAttributes\n * @param {string[]} conditions\n * @param {(specifier: string\x2C context: ModuleResolveContext) => ModuleResolveResult} defaultResolve\n * @returns {ModuleResolveResult}\n */\nfunction resolveWithHooks(specifier\x2C parentURL\x2C importAttributes\x2C conditions\x2C defaultResolve) {\n  debug('resolveWithHooks'\x2C specifier\x2C parentURL\x2C importAttributes);\n  const context = new ModuleResolveContext(parentURL\x2C importAttributes\x2C conditions);\n  if (resolveHooks.length === 0) {\n    return defaultResolve(specifier\x2C context);\n  }\n\n  const runner = buildHooks(resolveHooks\x2C 'resolve'\x2C defaultResolve\x2C validateResolve\x2C context);\n\n  return runner(specifier\x2C context);\n}\n\nmodule.exports = {\n  convertCJSFilenameToURL\x2C\n  convertURLToCJSFilename\x2C\n  loadHooks\x2C\n  loadWithHooks\x2C\n  registerHooks\x2C\n  resolveHooks\x2C\n  resolveWithHooks\x2C\n};\n

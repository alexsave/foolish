script-source,179,node:internal/modules/esm/hooks,'use strict';\n\nconst {\n  ArrayPrototypePush\x2C\n  ArrayPrototypePushApply\x2C\n  AtomicsLoad\x2C\n  AtomicsWait\x2C\n  AtomicsWaitAsync\x2C\n  Int32Array\x2C\n  ObjectAssign\x2C\n  ObjectDefineProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  Promise\x2C\n  ReflectSet\x2C\n  SafeSet\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeToUpperCase\x2C\n  globalThis\x2C\n} = primordials;\n\nconst {\n  SharedArrayBuffer\x2C\n} = globalThis;\n\nconst {\n  ERR_INTERNAL_ASSERTION\x2C\n  ERR_INVALID_ARG_TYPE\x2C\n  ERR_INVALID_ARG_VALUE\x2C\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\n  ERR_INVALID_RETURN_VALUE\x2C\n  ERR_LOADER_CHAIN_INCOMPLETE\x2C\n  ERR_METHOD_NOT_IMPLEMENTED\x2C\n  ERR_WORKER_UNSERIALIZABLE_ERROR\x2C\n} = require('internal/errors').codes;\nconst { exitCodes: { kUnsettledTopLevelAwait } } = internalBinding('errors');\nconst { URLParse } = require('internal/url');\nconst { canParse: URLCanParse } = internalBinding('url');\nconst { receiveMessageOnPort } = require('worker_threads');\nconst {\n  isAnyArrayBuffer\x2C\n  isArrayBufferView\x2C\n} = require('internal/util/types');\nconst {\n  validateObject\x2C\n  validateString\x2C\n} = require('internal/validators');\nconst {\n  kEmptyObject\x2C\n} = require('internal/util');\n\nconst {\n  defaultResolve\x2C\n  throwIfInvalidParentURL\x2C\n} = require('internal/modules/esm/resolve');\nconst {\n  getDefaultConditions\x2C\n  loaderWorkerId\x2C\n} = require('internal/modules/esm/utils');\nconst { deserializeError } = require('internal/error_serdes');\nconst {\n  SHARED_MEMORY_BYTE_LENGTH\x2C\n  WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C\n} = require('internal/modules/esm/shared_constants');\nlet debug = require('internal/util/debuglog').debuglog('esm'\x2C (fn) => {\n  debug = fn;\n});\nlet importMetaInitializer;\n\nlet importAssertionAlreadyWarned = false;\n\nfunction emitImportAssertionWarning() {\n  if (!importAssertionAlreadyWarned) {\n    importAssertionAlreadyWarned = true;\n    process.emitWarning('Use `importAttributes` instead of `importAssertions`'\x2C 'ExperimentalWarning');\n  }\n}\n\nfunction defineImportAssertionAlias(context) {\n  return ObjectDefineProperty(context\x2C 'importAssertions'\x2C {\n    __proto__: null\x2C\n    configurable: true\x2C\n    get() {\n      emitImportAssertionWarning();\n      return this.importAttributes;\n    }\x2C\n    set(value) {\n      emitImportAssertionWarning();\n      return ReflectSet(this\x2C 'importAttributes'\x2C value);\n    }\x2C\n  });\n}\n\n/**\n * @typedef {object} ExportedHooks\n * @property {Function} resolve Resolve hook.\n * @property {Function} load Load hook.\n */\n\n/**\n * @typedef {object} KeyedHook\n * @property {Function} fn The hook function.\n * @property {URL['href']} url The URL of the module.\n * @property {KeyedHook?} next The next hook in the chain.\n */\n\n// [2] `validate...()`s throw the wrong error\n\nclass Hooks {\n  #chains = {\n    /**\n     * Phase 1 of 2 in ESM loading.\n     * The output of the `resolve` chain of hooks is passed into the `load` chain of hooks.\n     * @private\n     * @property {KeyedHook[]} resolve Last-in-first-out collection of resolve hooks.\n     */\n    resolve: [\n      {\n        fn: defaultResolve\x2C\n        url: 'node:internal/modules/esm/resolve'\x2C\n      }\x2C\n    ]\x2C\n\n    /**\n     * Phase 2 of 2 in ESM loading.\n     * @private\n     * @property {KeyedHook[]} load Last-in-first-out collection of loader hooks.\n     */\n    load: [\n      {\n        fn: require('internal/modules/esm/load').defaultLoad\x2C\n        url: 'node:internal/modules/esm/load'\x2C\n      }\x2C\n    ]\x2C\n  };\n\n  // Cache URLs we've already validated to avoid repeated validation\n  #validatedUrls = new SafeSet();\n\n  allowImportMetaResolve = false;\n\n  /**\n   * Import and register custom/user-defined module loader hook(s).\n   * @param {string} urlOrSpecifier\n   * @param {string} parentURL\n   * @param {any} [data] Arbitrary data to be passed from the custom\n   * loader (user-land) to the worker.\n   */\n  async register(urlOrSpecifier\x2C parentURL\x2C data\x2C isInternal) {\n    const cascadedLoader = require('internal/modules/esm/loader').getOrInitializeCascadedLoader();\n    const keyedExports = isInternal ?\n      require(urlOrSpecifier) :\n      await cascadedLoader.import(\n        urlOrSpecifier\x2C\n        parentURL\x2C\n        kEmptyObject\x2C\n      );\n    await this.addCustomLoader(urlOrSpecifier\x2C keyedExports\x2C data);\n  }\n\n  /**\n   * Collect custom/user-defined module loader hook(s).\n   * @param {string} url Custom loader specifier\n   * @param {Record<string\x2C unknown>} exports\n   * @param {any} [data] Arbitrary data to be passed from the custom loader (user-land)\n   * to the worker.\n   * @returns {any | Promise<any>} User data\x2C ignored unless it's a promise\x2C in which case it will be awaited.\n   */\n  addCustomLoader(url\x2C exports\x2C data) {\n    const {\n      initialize\x2C\n      resolve\x2C\n      load\x2C\n    } = pluckHooks(exports);\n\n    if (resolve) {\n      const next = this.#chains.resolve[this.#chains.resolve.length - 1];\n      ArrayPrototypePush(this.#chains.resolve\x2C { __proto__: null\x2C fn: resolve\x2C url\x2C next });\n    }\n    if (load) {\n      const next = this.#chains.load[this.#chains.load.length - 1];\n      ArrayPrototypePush(this.#chains.load\x2C { __proto__: null\x2C fn: load\x2C url\x2C next });\n    }\n    return initialize?.(data);\n  }\n\n  /**\n   * Resolve the location of the module.\n   *\n   * Internally\x2C this behaves like a backwards iterator\x2C wherein the stack of\n   * hooks starts at the top and each call to `nextResolve()` moves down 1 step\n   * until it reaches the bottom or short-circuits.\n   * @param {string} originalSpecifier The specified URL path of the module to\n   *                                   be resolved.\n   * @param {string} [parentURL] The URL path of the module's parent.\n   * @param {ImportAttributes} [importAttributes] Attributes from the import\n   *                                              statement or expression.\n   * @returns {Promise<{ format: string\x2C url: URL['href'] }>}\n   */\n  async resolve(\n    originalSpecifier\x2C\n    parentURL\x2C\n    importAttributes = { __proto__: null }\x2C\n  ) {\n    throwIfInvalidParentURL(parentURL);\n\n    const chain = this.#chains.resolve;\n    const context = {\n      conditions: getDefaultConditions()\x2C\n      importAttributes\x2C\n      parentURL\x2C\n    };\n    const meta = {\n      chainFinished: null\x2C\n      context\x2C\n      hookErrIdentifier: ''\x2C\n      hookName: 'resolve'\x2C\n      shortCircuited: false\x2C\n    };\n\n    const validateArgs = (hookErrIdentifier\x2C suppliedSpecifier\x2C ctx) => {\n      validateString(\n        suppliedSpecifier\x2C\n        `${hookErrIdentifier} specifier`\x2C\n      ); // non-strings can be coerced to a URL string\n\n      if (ctx) { validateObject(ctx\x2C `${hookErrIdentifier} context`); }\n    };\n    const validateOutput = (hookErrIdentifier\x2C output) => {\n      if (typeof output !== 'object' || output === null) { // [2]\n        throw new ERR_INVALID_RETURN_VALUE(\n          'an object'\x2C\n          hookErrIdentifier\x2C\n          output\x2C\n        );\n      }\n    };\n\n    const nextResolve = nextHookFactory(chain[chain.length - 1]\x2C meta\x2C { validateArgs\x2C validateOutput });\n\n    const resolution = await nextResolve(originalSpecifier\x2C defineImportAssertionAlias(context));\n    const { hookErrIdentifier } = meta; // Retrieve the value after all settled\n\n    validateOutput(hookErrIdentifier\x2C resolution);\n\n    if (resolution?.shortCircuit === true) { meta.shortCircuited = true; }\n\n    if (!meta.chainFinished && !meta.shortCircuited) {\n      throw new ERR_LOADER_CHAIN_INCOMPLETE(hookErrIdentifier);\n    }\n\n    let resolvedImportAttributes;\n    const {\n      format\x2C\n      url\x2C\n    } = resolution;\n\n    if (typeof url !== 'string') {\n      // non-strings can be coerced to a URL string\n      // validateString() throws a less-specific error\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'a URL string'\x2C\n        hookErrIdentifier\x2C\n        'url'\x2C\n        url\x2C\n      );\n    }\n\n    // Avoid expensive URL instantiation for known-good URLs\n    if (!this.#validatedUrls.has(url)) {\n      // No need to convert to string\x2C since the type is already validated\n      if (!URLCanParse(url)) {\n        throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n          'a URL string'\x2C\n          hookErrIdentifier\x2C\n          'url'\x2C\n          url\x2C\n        );\n      }\n\n      this.#validatedUrls.add(url);\n    }\n\n    if (!('importAttributes' in resolution) && ('importAssertions' in resolution)) {\n      emitImportAssertionWarning();\n      resolvedImportAttributes = resolution.importAssertions;\n    } else {\n      resolvedImportAttributes = resolution.importAttributes;\n    }\n\n    if (\n      resolvedImportAttributes != null &&\n      typeof resolvedImportAttributes !== 'object'\n    ) {\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'an object'\x2C\n        hookErrIdentifier\x2C\n        'importAttributes'\x2C\n        resolvedImportAttributes\x2C\n      );\n    }\n\n    if (\n      format != null &&\n      typeof format !== 'string' // [2]\n    ) {\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'a string'\x2C\n        hookErrIdentifier\x2C\n        'format'\x2C\n        format\x2C\n      );\n    }\n\n    return {\n      __proto__: null\x2C\n      format\x2C\n      importAttributes: resolvedImportAttributes\x2C\n      url\x2C\n    };\n  }\n\n  resolveSync(_originalSpecifier\x2C _parentURL\x2C _importAttributes) {\n    throw new ERR_METHOD_NOT_IMPLEMENTED('resolveSync()');\n  }\n\n  /**\n   * Provide source that is understood by one of Node's translators.\n   *\n   * Internally\x2C this behaves like a backwards iterator\x2C wherein the stack of\n   * hooks starts at the top and each call to `nextLoad()` moves down 1 step\n   * until it reaches the bottom or short-circuits.\n   * @param {URL['href']} url The URL/path of the module to be loaded\n   * @param {object} context Metadata about the module\n   * @returns {Promise<{ format: ModuleFormat\x2C source: ModuleSource }>}\n   */\n  async load(url\x2C context = {}) {\n    const chain = this.#chains.load;\n    const meta = {\n      chainFinished: null\x2C\n      context\x2C\n      hookErrIdentifier: ''\x2C\n      hookName: 'load'\x2C\n      shortCircuited: false\x2C\n    };\n\n    const validateArgs = (hookErrIdentifier\x2C nextUrl\x2C ctx) => {\n      if (typeof nextUrl !== 'string') {\n        // Non-strings can be coerced to a URL string\n        // validateString() throws a less-specific error\n        throw new ERR_INVALID_ARG_TYPE(\n          `${hookErrIdentifier} url`\x2C\n          'a URL string'\x2C\n          nextUrl\x2C\n        );\n      }\n\n      // Avoid expensive URL instantiation for known-good URLs\n      if (!this.#validatedUrls.has(nextUrl)) {\n        // No need to convert to string\x2C since the type is already validated\n        if (!URLCanParse(nextUrl)) {\n          throw new ERR_INVALID_ARG_VALUE(\n            `${hookErrIdentifier} url`\x2C\n            nextUrl\x2C\n            'should be a URL string'\x2C\n          );\n        }\n\n        this.#validatedUrls.add(nextUrl);\n      }\n\n      if (ctx) { validateObject(ctx\x2C `${hookErrIdentifier} context`); }\n    };\n    const validateOutput = (hookErrIdentifier\x2C output) => {\n      if (typeof output !== 'object' || output === null) { // [2]\n        throw new ERR_INVALID_RETURN_VALUE(\n          'an object'\x2C\n          hookErrIdentifier\x2C\n          output\x2C\n        );\n      }\n    };\n\n    const nextLoad = nextHookFactory(chain[chain.length - 1]\x2C meta\x2C { validateArgs\x2C validateOutput });\n\n    const loaded = await nextLoad(url\x2C defineImportAssertionAlias(context));\n    const { hookErrIdentifier } = meta; // Retrieve the value after all settled\n\n    validateOutput(hookErrIdentifier\x2C loaded);\n\n    if (loaded?.shortCircuit === true) { meta.shortCircuited = true; }\n\n    if (!meta.chainFinished && !meta.shortCircuited) {\n      throw new ERR_LOADER_CHAIN_INCOMPLETE(hookErrIdentifier);\n    }\n\n    const {\n      format\x2C\n      source\x2C\n    } = loaded;\n    let responseURL = loaded.responseURL;\n\n    if (responseURL === undefined) {\n      responseURL = url;\n    }\n\n    let responseURLObj;\n    if (typeof responseURL === 'string') {\n      responseURLObj = URLParse(responseURL);\n    }\n\n    if (responseURLObj?.href !== responseURL) {\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'undefined or a fully resolved URL string'\x2C\n        hookErrIdentifier\x2C\n        'responseURL'\x2C\n        responseURL\x2C\n      );\n    }\n\n    if (format == null) {\n      require('internal/modules/esm/load').throwUnknownModuleFormat(url\x2C format);\n    }\n\n    if (typeof format !== 'string') { // [2]\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'a string'\x2C\n        hookErrIdentifier\x2C\n        'format'\x2C\n        format\x2C\n      );\n    }\n\n    if (\n      source != null &&\n      typeof source !== 'string' &&\n      !isAnyArrayBuffer(source) &&\n      !isArrayBufferView(source)\n    ) {\n      throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n        'a string\x2C an ArrayBuffer\x2C or a TypedArray'\x2C\n        hookErrIdentifier\x2C\n        'source'\x2C\n        source\x2C\n      );\n    }\n\n    return {\n      __proto__: null\x2C\n      format\x2C\n      responseURL\x2C\n      source\x2C\n    };\n  }\n\n  forceLoadHooks() {\n    // No-op\n  }\n\n  importMetaInitialize(meta\x2C context\x2C loader) {\n    importMetaInitializer ??= require('internal/modules/esm/initialize_import_meta').initializeImportMeta;\n    meta = importMetaInitializer(meta\x2C context\x2C loader);\n    return meta;\n  }\n}\nObjectSetPrototypeOf(Hooks.prototype\x2C null);\n\n/**\n * There may be multiple instances of Hooks/HooksProxy\x2C but there is only 1 Internal worker\x2C so\n * there is only 1 MessageChannel.\n */\nlet MessageChannel;\nclass HooksProxy {\n  /**\n   * Shared memory. Always use Atomics method to read or write to it.\n   * @type {Int32Array}\n   */\n  #lock;\n  /**\n   * The InternalWorker instance\x2C which lets us communicate with the loader thread.\n   */\n  #worker;\n\n  /**\n   * The last notification ID received from the worker. This is used to detect\n   * if the worker has already sent a notification before putting the main\n   * thread to sleep\x2C to avoid a race condition.\n   * @type {number}\n   */\n  #workerNotificationLastId = 0;\n\n  /**\n   * Track how many async responses the main thread should expect.\n   * @type {number}\n   */\n  #numberOfPendingAsyncResponses = 0;\n\n  #isReady = false;\n\n  constructor() {\n    const { InternalWorker } = require('internal/worker');\n    MessageChannel ??= require('internal/worker/io').MessageChannel;\n\n    const lock = new SharedArrayBuffer(SHARED_MEMORY_BYTE_LENGTH);\n    this.#lock = new Int32Array(lock);\n\n    this.#worker = new InternalWorker(loaderWorkerId\x2C {\n      stderr: false\x2C\n      stdin: false\x2C\n      stdout: false\x2C\n      trackUnmanagedFds: false\x2C\n      workerData: {\n        lock\x2C\n      }\x2C\n    });\n    this.#worker.unref(); // ! Allows the process to eventually exit.\n    this.#worker.on('exit'\x2C process.exit);\n  }\n\n  waitForWorker() {\n    if (!this.#isReady) {\n      const { kIsOnline } = require('internal/worker');\n      if (!this.#worker[kIsOnline]) {\n        debug('wait for signal from worker');\n        AtomicsWait(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C 0);\n        const response = this.#worker.receiveMessageSync();\n        if (response == null || response.message.status === 'exit') { return; }\n\n        // ! This line catches initialization errors in the worker thread.\n        this.#unwrapMessage(response);\n      }\n\n      this.#isReady = true;\n    }\n  }\n\n  /**\n   * Invoke a remote method asynchronously.\n   * @param {string} method Method to invoke\n   * @param {any[]} [transferList] Objects in `args` to be transferred\n   * @param  {any[]} args Arguments to pass to `method`\n   * @returns {Promise<any>}\n   */\n  async makeAsyncRequest(method\x2C transferList\x2C ...args) {\n    this.waitForWorker();\n\n    MessageChannel ??= require('internal/worker/io').MessageChannel;\n    const asyncCommChannel = new MessageChannel();\n\n    // Pass work to the worker.\n    debug('post async message to worker'\x2C { method\x2C args\x2C transferList });\n    const finalTransferList = [asyncCommChannel.port2];\n    if (transferList) {\n      ArrayPrototypePushApply(finalTransferList\x2C transferList);\n    }\n    this.#worker.postMessage({\n      __proto__: null\x2C\n      method\x2C args\x2C\n      port: asyncCommChannel.port2\x2C\n    }\x2C finalTransferList);\n\n    if (this.#numberOfPendingAsyncResponses++ === 0) {\n      // On the next lines\x2C the main thread will await a response from the worker thread that might\n      // come AFTER the last task in the event loop has run its course and there would be nothing\n      // left keeping the thread alive (and once the main thread dies\x2C the whole process stops).\n      // However we want to keep the process alive until the worker thread responds (or until the\n      // event loop of the worker thread is also empty)\x2C so we ref the worker until we get all the\n      // responses back.\n      this.#worker.ref();\n    }\n\n    let response;\n    do {\n      debug('wait for async response from worker'\x2C { method\x2C args });\n      await AtomicsWaitAsync(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C this.#workerNotificationLastId).value;\n      this.#workerNotificationLastId = AtomicsLoad(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION);\n\n      response = receiveMessageOnPort(asyncCommChannel.port1);\n    } while (response == null);\n    debug('got async response from worker'\x2C { method\x2C args }\x2C this.#lock);\n\n    if (--this.#numberOfPendingAsyncResponses === 0) {\n      // We got all the responses from the worker\x2C its job is done (until next time).\n      this.#worker.unref();\n    }\n\n    const body = this.#unwrapMessage(response);\n    asyncCommChannel.port1.close();\n    return body;\n  }\n\n  /**\n   * Invoke a remote method synchronously.\n   * @param {string} method Method to invoke\n   * @param {any[]} [transferList] Objects in `args` to be transferred\n   * @param  {any[]} args Arguments to pass to `method`\n   * @returns {any}\n   */\n  makeSyncRequest(method\x2C transferList\x2C ...args) {\n    this.waitForWorker();\n\n    // Pass work to the worker.\n    debug('post sync message to worker'\x2C { method\x2C args\x2C transferList });\n    this.#worker.postMessage({ __proto__: null\x2C method\x2C args }\x2C transferList);\n\n    let response;\n    do {\n      debug('wait for sync response from worker'\x2C { method\x2C args });\n      // Sleep until worker responds.\n      AtomicsWait(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C this.#workerNotificationLastId);\n      this.#workerNotificationLastId = AtomicsLoad(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION);\n\n      response = this.#worker.receiveMessageSync();\n    } while (response == null);\n    debug('got sync response from worker'\x2C { method\x2C args });\n    if (response.message.status === 'never-settle') {\n      process.exit(kUnsettledTopLevelAwait);\n    } else if (response.message.status === 'exit') {\n      process.exit(response.message.body);\n    }\n    return this.#unwrapMessage(response);\n  }\n\n  #unwrapMessage(response) {\n    if (response.message.status === 'never-settle') {\n      return new Promise(() => {});\n    }\n    const { status\x2C body } = response.message;\n    if (status === 'error') {\n      if (body == null || typeof body !== 'object') { throw body; }\n      if (body.serializationFailed || body.serialized == null) {\n        throw new ERR_WORKER_UNSERIALIZABLE_ERROR();\n      }\n\n      // eslint-disable-next-line no-restricted-syntax\n      throw deserializeError(body.serialized);\n    } else {\n      return body;\n    }\n  }\n\n  #importMetaInitializer = require('internal/modules/esm/initialize_import_meta').initializeImportMeta;\n\n  importMetaInitialize(meta\x2C context\x2C loader) {\n    this.#importMetaInitializer(meta\x2C context\x2C loader);\n  }\n}\nObjectSetPrototypeOf(HooksProxy.prototype\x2C null);\n\n// TODO(JakobJingleheimer): Remove this when loaders go "stable".\nlet globalPreloadWarningWasEmitted = false;\n\n/**\n * A utility function to pluck the hooks from a user-defined loader.\n * @param {import('./loader.js).ModuleExports} exports\n * @returns {ExportedHooks}\n */\nfunction pluckHooks({\n  globalPreload\x2C\n  initialize\x2C\n  resolve\x2C\n  load\x2C\n}) {\n  const acceptedHooks = { __proto__: null };\n\n  if (resolve) {\n    acceptedHooks.resolve = resolve;\n  }\n  if (load) {\n    acceptedHooks.load = load;\n  }\n\n  if (initialize) {\n    acceptedHooks.initialize = initialize;\n  } else if (globalPreload && !globalPreloadWarningWasEmitted) {\n    process.emitWarning(\n      '`globalPreload` has been removed; use `initialize` instead.'\x2C\n      'UnsupportedWarning'\x2C\n    );\n    globalPreloadWarningWasEmitted = true;\n  }\n\n  return acceptedHooks;\n}\n\n\n/**\n * A utility function to iterate through a hook chain\x2C track advancement in the\n * chain\x2C and generate and supply the `next<HookName>` argument to the custom\n * hook.\n * @param {KeyedHook} current The (currently) first hook in the chain (this shifts\n * on every call).\n * @param {object} meta Properties that change as the current hook advances\n * along the chain.\n * @
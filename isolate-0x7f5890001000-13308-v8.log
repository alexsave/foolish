script-source,173,node:internal/modules/customization_hooks,'use strict';\n\nconst {\n  ArrayPrototypeFindIndex\x2C\n  ArrayPrototypePush\x2C\n  ArrayPrototypeSplice\x2C\n  ObjectAssign\x2C\n  ObjectFreeze\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeStartsWith\x2C\n  Symbol\x2C\n} = primordials;\nconst {\n  isAnyArrayBuffer\x2C\n  isArrayBufferView\x2C\n} = require('internal/util/types');\n\nconst { BuiltinModule } = require('internal/bootstrap/realm');\nconst {\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\n} = require('internal/errors').codes;\nconst { validateFunction } = require('internal/validators');\nconst { isAbsolute } = require('path');\nconst { pathToFileURL\x2C fileURLToPath } = require('internal/url');\n\nlet debug = require('internal/util/debuglog').debuglog('module_hooks'\x2C (fn) => {\n  debug = fn;\n});\n\n/**\n * @typedef {import('internal/modules/cjs/loader.js').Module} Module\n */\n/**\n * @typedef {(\n *   specifier: string\x2C\n *   context: Partial<ModuleResolveContext>\x2C\n * ) => ModuleResolveResult\n * } NextResolve\n * @typedef {(\n *   specifier: string\x2C\n *   context: ModuleResolveContext\x2C\n *   nextResolve: NextResolve\x2C\n * ) => ModuleResolveResult\n * } ResolveHook\n * @typedef {(\n *   url: string\x2C\n *   context: Partial<ModuleLoadContext>\x2C\n * ) => ModuleLoadResult\n * } NextLoad\n * @typedef {(\n *   url: string\x2C\n *   context: ModuleLoadContext\x2C\n *   nextLoad: NextLoad\x2C\n * ) => ModuleLoadResult\n * } LoadHook\n */\n\n// Use arrays for better insertion and iteration performance\x2C we don't care\n// about deletion performance as much.\n\n/** @type {ResolveHook[]} */\nconst resolveHooks = [];\n/** @type {LoadHook[]} */\nconst loadHooks = [];\nconst hookId = Symbol('kModuleHooksIdKey');\nlet nextHookId = 0;\n\nclass ModuleHooks {\n  /**\n   * @param {ResolveHook|undefined} resolve User-provided hook.\n   * @param {LoadHook|undefined} load User-provided hook.\n   */\n  constructor(resolve\x2C load) {\n    this[hookId] = Symbol(`module-hook-${nextHookId++}`);\n    // Always initialize all hooks\x2C if it's unspecified it'll be an owned undefined.\n    this.resolve = resolve;\n    this.load = load;\n\n    if (resolve) {\n      ArrayPrototypePush(resolveHooks\x2C this);\n    }\n    if (load) {\n      ArrayPrototypePush(loadHooks\x2C this);\n    }\n\n    ObjectFreeze(this);\n  }\n  // TODO(joyeecheung): we may want methods that allow disabling/enabling temporarily\n  // which just sets the item in the array to undefined temporarily.\n  // TODO(joyeecheung): this can be the [Symbol.dispose] implementation to pair with\n  // `using` when the explicit resource management proposal is shipped by V8.\n  /**\n   * Deregister the hook instance.\n   */\n  deregister() {\n    const id = this[hookId];\n    let index = ArrayPrototypeFindIndex(resolveHooks\x2C (hook) => hook[hookId] === id);\n    if (index !== -1) {\n      ArrayPrototypeSplice(resolveHooks\x2C index\x2C 1);\n    }\n    index = ArrayPrototypeFindIndex(loadHooks\x2C (hook) => hook[hookId] === id);\n    if (index !== -1) {\n      ArrayPrototypeSplice(loadHooks\x2C index\x2C 1);\n    }\n  }\n};\n\n/**\n * TODO(joyeecheung): taken an optional description?\n * @param {{ resolve?: ResolveHook\x2C load?: LoadHook }} hooks User-provided hooks\n * @returns {ModuleHooks}\n */\nfunction registerHooks(hooks) {\n  const { resolve\x2C load } = hooks;\n  if (resolve) {\n    validateFunction(resolve\x2C 'hooks.resolve');\n  }\n  if (load) {\n    validateFunction(load\x2C 'hooks.load');\n  }\n  return new ModuleHooks(resolve\x2C load);\n}\n\n/**\n * @param {string} filename\n * @returns {string}\n */\nfunction convertCJSFilenameToURL(filename) {\n  if (!filename) { return filename; }\n  let normalizedId = filename;\n  if (StringPrototypeStartsWith(filename\x2C 'node:')) {\n    normalizedId = StringPrototypeSlice(filename\x2C 5);\n  }\n  if (BuiltinModule.canBeRequiredByUsers(normalizedId)) {\n    return `node:${normalizedId}`;\n  }\n  /
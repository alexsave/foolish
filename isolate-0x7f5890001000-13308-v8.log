script-source,178,node:internal/modules/esm/shared_constants,// This file contains the definition for the constant values that must be\n// available to both the main thread and the loader thread.\n\n'use strict';\n\n/*\nThe shared memory area is divided in 1 32-bit long section. It has to be 32-bit long as\n`Atomics.notify` only works with `Int32Array` objects.\n\n--32-bits--\n    ^\n    |\n    |\nWORKER_TO_MAIN_THREAD_NOTIFICATION\n\nWORKER_TO_MAIN_THREAD_NOTIFICATION is only used to send notifications\x2C its value is going to\nincrease every time the worker sends a notification to the main thread.\n\n*/\n\nmodule.exports = {\n  WORKER_TO_MAIN_THREAD_NOTIFICATION: 0\x2C\n\n  SHARED_MEMORY_BYTE_LENGTH: 1 * 4\x2C\n};\n

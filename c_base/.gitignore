# Build outputs (make clean removes them).
/build/
# The migration export: it holds password hashes. Never commit it.
/migrate/out/
# A local database from `build/cbase` run in this directory.
/*.sqlite
/*.sqlite-wal
/*.sqlite-shm
/dist/
# ops/deploy.sh's settings and generated secrets (mode 0600). Never commit it.
/ops/.env
# bench runs (cbase-bench); only the committed baseline, named baseline-*.txt, is tracked.
/bench/results/*.txt
!/bench/results/baseline-*.txt

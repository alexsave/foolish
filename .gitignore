# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.js

# testing
/coverage
tests/coverage

# production
/build
/dist

# next.js
/.next/
/out/
/next-env.d.ts
*.tsbuildinfo

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
.env
.env.build
.vercel

# Vim swap files. NOTE: must not be `*.sw*` — that also swallows *.swift
# (the entire iOS app). Match only the real swap extensions.
*.swp
*.swo
*.swn
.*.sw?
.vscode
.cursor

server/api/common/durakai/move_analysis.txt
server/api/common/durakai/node_modules

# c
c/build/
c/*.trace/
c/tools/tt_divergence_viz/backup/
c/tools/tt_divergence_viz/backup2/
c/tools/tt_divergence_viz/data/W/

# Local scratch that has snuck into commits before. Bare-name editor spill
# (.swc..swm, not caught by .*.sw? which guards .swift), a dev server log, the
# iOS snapshot-test output dir, and the memtest edge scratch function.
.sw[c-m]
.watchrealsizevim
serve.log
ios/FoolishTests/__Snapshots__/
server/impls/supabase/functions/memtest/

# local dev overrides (shadows next.config.mjs if tracked!)
next.config.js

# Local Claude Code agent worktrees / local state — ignored, EXCEPT the shared
# project hook below (installs binaryen so `make wasm-bots` can run wasm-opt).
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
isolate-*.log

# Coverage artifacts
.v8cov/

# COPIED from pickemup/ios/Tools/rig.env at 8e216923 - drive THE rig at foolish/ios/Tools/rig against Tallybones.
#
# The rig is one tool with a product block at the top of rig.sh; a second
# product is that block with different strings and nothing more.
#
#   source tallybones/ios/Tools/rig.env
#   eval "$(foolish/ios/Tools/rig/rig.sh newsim TallybonesRig)"
#   foolish/ios/Tools/rig/rig.sh doctor
#   foolish/ios/Tools/rig/rig.sh build
#
# EVERY PATH FROM THIS FILE'S OWN LOCATION, so any checkout or worktree drives
# its own tree. bash sets BASH_SOURCE; zsh's `source` answers %x.
#
# RIG_KERNEL_DIR names tallybones/c, whose `make ios-lib` `rig.sh build` runs
# first. It is never left empty: rig.sh reads an empty RIG_KERNEL_DIR as
# "foolish's c/" and would build the wrong kernel.
_tb_env="${BASH_SOURCE[0]:-${(%):-%x}}"
_tb_ios="$(cd "$(dirname "$_tb_env")/.." && pwd)"
export RIG_APP_ID=cards.tallybones
export RIG_EXT_DOM=cards.tallybones.msg
export RIG_APP_GROUP=group.cards.tallybones
export RIG_SCHEME=TallybonesMessagesApp
export RIG_XCPROJ="$_tb_ios/Tallybones.xcodeproj"
export RIG_APP_BUNDLE=TallybonesMessagesApp.app
export RIG_APPEX=TallybonesMessages
export RIG_MENU_NAME="Tallybones"
export RIG_LOG_SUBSYSTEM=cards.tallybones
export RIG_KERNEL_DIR="$(cd "$_tb_ios/.." && pwd)/c"
export RIG_IOS_DIR="$_tb_ios"
# No transcript seeder yet: `build` and `doctor` stop asking for one.
export RIG_SEEDER=
unset _tb_env _tb_ios

# structgen arguments for sdk/swift/gen/kernel.ios.swift: the structs the iOS
# app reads out of the kernel it LINKS, as Swift value snapshots.
#
# Read by tools/structgen/gen.sh and by c/Makefile (the ios-lib rule), both with
# --cwd c/, the iOS caps and the iOS triple, so the module and the library carry
# ONE layout hash - a stale xcframework or a stale module is a refusal at
# startup (sdk/swift/KernelLayout.swift) rather than a wrong offset.
# Lines starting with # are dropped; everything else is split on whitespace.
#
# WHY A SEPARATE RUN from game_layout.args. The iOS caps are not the wasm caps
# (MAX_BATTLES, the replay arenas) and the triple is not wasm32, so every offset
# here is its own; and iOS reads a different set of structs, because it reads
# them where they lie instead of off a wire.
--header client_table.h --header anim_plan.h --header bot_drive.h --header msg_wire.h --header roster.h
#
# The client's slot (client_table.h): one viewer's masked board joined to the
# table's roster. What MaskedView.swift and PackedGame.swift used to walk byte
# by byte, and what a push's steps commit.
--root TableView --root PushEvent --root ViewRules
--snapshot TableView --snapshot PushEvent --snapshot ViewRules
--count TableView.battles=num_battles --count TableView.seats=num_players
--count TableView.my_hand=my_hand_count --count TableView.elimination=num_eliminated
--count TableView.game_id=gid_len --count TableView.title=title_len
--count ViewSeat.id=id_len --count ViewSeat.name=name_len
--count PushEvent.cards=n_cards
#
# The animation plan, a frame of it, and the beats (anim_plan.h). AnimPlanStep,
# AnimCounts and AnimBeat come with them as embedded records.
# AnimCounts.battles is NOT counted by n_battles: it holds TWO bytes per battle
# (attack, cover), so the count is not the array's length. The whole row crosses
# and n_battles crosses with it.
--root AnimPlan --root AnimFrame --root AnimBeats --root AnimSurfacePlan
--snapshot AnimPlan --snapshot AnimFrame --snapshot AnimBeats --snapshot AnimSurfacePlan
--count AnimPlan.steps=n_steps --count AnimPlan.veil_ids=n_veil
--count AnimCounts.hand=n_players --count AnimFrame.hand=n_players
--count AnimBeats.beats=n_beats --count AnimSurfacePlan.beats=n
#
# One bot cycle (bot_drive.h), as BotDriveWire.swift decoded it out of a packed
# blob. LegalMove crosses with the same fields the TS side reads.
--root BotDriveOut
--snapshot BotDriveOut
--fields LegalMove=type,n_cards,cards,attack_cards
--count BotDriveOut.actions=n --count LegalMove.cards=n_cards --count LegalMove.attack_cards=n_cards
#
# The table's identity (roster.h), for the seats of a lobby the board has not
# dealt yet.
--root Roster
--snapshot Roster
--count Roster.seats=n --count Roster.title=title_len
--count RosterSeat.id=id_len --count RosterSeat.name=name_len --count RosterSeat.brain=brain_len
#
# The iMessage envelope's header (msg_wire.h), which MessageEnvelope.swift used
# to read out of a packed blob ios_api.c wrote for it alone. The fields are
# everything but the BORROWED BODY (actions, actions_len, n_actions), which no
# host holds.
--root MsgHeader
--snapshot MsgHeader
--fields MsgEnvelope=format,flags,phase,game_id,turn,last_actor_seat,n_players,variant,round,parent8,seed,sent_at,n_new,opening,carry_key,carry_fool,n_joins,joins
--count MsgEnvelope.joins=n_joins --count MsgJoin.name=name_len
#
# The constants a reader of these structs needs, and no others: every one is a
# public symbol in FoolishKit.
--const CLIENT_ --const ANIM_EVT_ --const ANIM_LOC_ --const ANIM_DEST_ --const ANIM_CONFLICT_
--const ANIM_SEAT_NONE --const ANIM_STEP_NONE --const ANIM_NEVER --const ANIM_TIME_MS --const ANIM_GAP_MS
--const ANIM_NO_MASK --const ANIM_BEAT_ --const ANIM_SURFACE_ --const ANIM_TABLE_NONE
--const BOT_STOP_ --const BOT_PACE_ --const MOVE_
--const GAME_STATUS_ --const PLAYER_STATUS_ --const ROSTER_E_ --const MSG_

# Drive THE rig at foolish/ios/Tools/rig against Pick 'Em Up (uttt/ios/Tools/rig.env's shape).
#
# The rig is one tool with a product block at the top of rig.sh; a second
# product is that block with different strings and nothing more.
#
#   source pickemup/ios/Tools/rig.env
#   eval "$(foolish/ios/Tools/rig/rig.sh newsim PickemupRig)"
#   foolish/ios/Tools/rig/rig.sh doctor
#   foolish/ios/Tools/rig/rig.sh build
#
# EVERY PATH FROM THIS FILE'S OWN LOCATION, so any checkout or worktree drives
# its own tree (uttt's absolute paths got away once: the rig built another
# worktree's kernel into this one's app). bash sets BASH_SOURCE; zsh's `source`
# answers %x.
_pk_env="${BASH_SOURCE[0]:-${(%):-%x}}"
_pk_ios="$(cd "$(dirname "$_pk_env")/.." && pwd)"
export RIG_APP_ID=cards.pickemup
export RIG_EXT_DOM=cards.pickemup.msg
export RIG_APP_GROUP=group.cards.pickemup
export RIG_SCHEME=PickemupMessagesApp
export RIG_XCPROJ="$_pk_ios/Pickemup.xcodeproj"
export RIG_APP_BUNDLE=PickemupMessagesApp.app
export RIG_APPEX=PickemupMessages
export RIG_MENU_NAME="Pick 'Em Up"
export RIG_LOG_SUBSYSTEM=cards.pickemup
export RIG_KERNEL_DIR="$(cd "$_pk_ios/../c" && pwd)"
export RIG_IOS_DIR="$_pk_ios"
# No transcript seeder yet: `build` and `doctor` stop asking for one.
export RIG_SEEDER=
unset _pk_env _pk_ios

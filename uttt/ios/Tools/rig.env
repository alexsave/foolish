# Drive THE rig at foolish/ios/Tools/rig against Ultimate Tic-Tac-Toe.
#
# The rig is one tool with a product block at the top of rig.sh, and a second
# product is that block with different strings and deliberately nothing more -
# so this file is the whole port of it. There is no plugin system here and
# there should not be one.
#
#   source uttt/ios/Tools/rig.env
#   eval "$(foolish/ios/Tools/rig/rig.sh newsim UtttRig)"
#   foolish/ios/Tools/rig/rig.sh doctor
#   foolish/ios/Tools/rig/rig.sh build
#
# EVERY PATH FROM THIS FILE'S OWN LOCATION, so any checkout or worktree drives
# its own tree: absolute paths here built the main checkout's kernel into a
# worktree's app. bash sets BASH_SOURCE; zsh's `source` answers %x.
_uttt_env="${BASH_SOURCE[0]:-${(%):-%x}}"
_uttt_ios="$(cd "$(dirname "$_uttt_env")/.." && pwd)"
export RIG_APP_ID=cards.uttt.msg
export RIG_EXT_DOM=cards.uttt.msg.MessagesExtension
export RIG_APP_GROUP=group.cards.uttt.msg
export RIG_SCHEME=UtttMessagesApp
export RIG_XCPROJ="$_uttt_ios/Uttt.xcodeproj"
export RIG_APP_BUNDLE=UtttMessagesApp.app
export RIG_APPEX=UtttMessages
export RIG_MENU_NAME=Ultimate
export RIG_LOG_SUBSYSTEM=cards.uttt
# WHERE the product lives. A monorepo's second product is not at c/ and ios/,
# and `build` used to spell Durak's layout even with everything above set -
# so it compiled the wrong kernel into the right app and said nothing.
export RIG_KERNEL_DIR="$(cd "$_uttt_ios/../c" && pwd)"
export RIG_IOS_DIR="$_uttt_ios"
# No transcript seeder here yet. Durak seeds a fat board through a C tool;
# empty means `build` and `doctor` stop asking for one.
export RIG_SEEDER=
# THE 243 BOARD (docs/BIG_BOARD.md) compiles in through project.yml's one
# switch, UTTT_BIG_BOARD_CONDITION. The rig puts its conditions on the build
# command line, which replaces the project's, so the switch is named here as a
# reference and expands to whatever project.yml says: delete the word there
# and the rig's build compiles the feature out too.
export RIG_SWIFT_CONDITIONS='$(UTTT_BIG_BOARD_CONDITION)'
unset _uttt_env _uttt_ios

# App Store Connect ids for Ultimate Tic-Tac-Toe - the product block for
# shared/tools/asc/testflight.py, the way rig.env is the rig's. Ids, not
# secrets: the API key lives in ~/.appstoreconnect and nowhere in the repo.
#
#   source uttt/ios/Tools/asc.env
#   shared/tools/asc/testflight.py status
#   uttt/ios/Tools/ship.sh                       # upload the next build
#   shared/tools/asc/testflight.py release -m "What to test"
#
# The app record itself (6815039449) was created in the web UI: the API
# refuses to create apps for any key.
export ASC_APP_ID=6815039449
export ASC_EXTERNAL_GROUP=23a0ec0e-65b8-42cb-9ec9-c9df25b05406   # "UTTT iMessage Ext", public link
export ASC_INTERNAL_GROUP=21347095-469f-45d1-b51a-bce436d62b0a   # "UTTT Internal", all builds

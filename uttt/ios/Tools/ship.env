# The product block for shared/tools/ship/ship.sh, shared/tools/devlogs.sh and
# shared/tools/devcap/devcap.sh:
# Ultimate Tic-Tac-Toe's iMessage app. Ids, not secrets - the API key and the
# keychain password come from the environment. Paths are from the repo root.
SHIP_NAME=uttt
SHIP_APP_ID=6815039449
SHIP_BUNDLE=cards.uttt.msg
SHIP_EXT_BUNDLE=cards.uttt.msg.MessagesExtension
SHIP_TEAM=8N2Z544SB4
SHIP_APP_PROFILE="Uttt Msg Store 1"
SHIP_EXT_PROFILE="Uttt MsgExt Store 1"
SHIP_SCHEME=UtttMessagesApp
SHIP_XCPROJ=uttt/ios/Uttt.xcodeproj
SHIP_KERNEL_DIR=uttt/c
SHIP_IOS_DIR=uttt/ios
SHIP_VERSION_FILE=uttt/ios/project.yml
SHIP_APP=UtttMessagesApp.app
SHIP_APPEX=UtttMessages.appex
# Release asks for NO App Group (see project.yml); the store profiles have none.
SHIP_APP_GROUP=
# The DEBUG build's App Group, where dev.* files live (devcap.sh, the rig).
DEV_APP_GROUP=group.cards.uttt.msg
# os_log subsystem prefix, for shared/tools/devlogs.sh show.
SHIP_LOG_SUBSYSTEM=cards.uttt
SIGNING_KEYCHAIN="${SIGNING_KEYCHAIN:-$HOME/Library/Keychains/foolish-signing.keychain-db}"

# Drive the Messages rig (the card game's ios/Tools/rig/rig.sh) against the
# layout probe. The rig is one tool with a product block at its top, and a
# second product is that block with different strings - so this file is the
# whole port. README.md has the commands.
#
#   source shared/tools/layout_probe/rig.env
#
# Only the navigation half is used (stage, open, turn, tapopen, leave, flight):
# the probe has no kernel and `make app` here builds it, so the rig's own
# `build` is not asked for and its project path is not set.
#
# Every path from this file's own location, so any checkout or worktree drives
# its own tree. bash sets BASH_SOURCE; zsh's `source` answers %x.
_lp_env="${BASH_SOURCE[0]:-${(%):-%x}}"
_lp_dir="$(cd "$(dirname "$_lp_env")" && pwd)"
export RIG_APP_ID=tools.layoutprobe.msg
export RIG_EXT_DOM=tools.layoutprobe.msg.Ext
export RIG_APP_GROUP=group.tools.layoutprobe.msg
export RIG_SCHEME=LayoutProbeApp
export RIG_APP_BUNDLE=LayoutProbeApp.app
export RIG_APPEX=LayoutProbeExt
export RIG_MENU_NAME=Probe
export RIG_LOG_SUBSYSTEM=tools.layoutprobe
export RIG_KERNEL_DIR="$_lp_dir"
export RIG_IOS_DIR="$_lp_dir/ios"
export RIG_SEEDER=
# The built app, for `xcrun simctl install`.
export LAYOUT_PROBE_APP="$_lp_dir/ios/build/dd/Build/Products/Debug-iphonesimulator/LayoutProbeApp.app"
unset _lp_env _lp_dir

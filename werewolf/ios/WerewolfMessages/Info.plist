<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Werewolf</string>
	<key>CFBundleName</key>
	<string>Werewolf</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- installd REFUSES an .appex without this ("missing or invalid
	     CFBundleExecutable"), and a hand-written plist does not get it for free:
	     Xcode only injects it into plists it generates. -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The .appex is a separate binary from its container, so it needs its own
	     export-compliance declaration. This binary runs SHA-256 (c/src/sha256.c)
	     over the payload to order and link chains - a digest used for identity,
	     not encryption of anything. Revisit this key specifically if the payload
	     path ever starts encrypting bytes rather than digesting them. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The App Group the nickname lives in. Must match
	     WerewolfMessages.entitlements and the portal's App Group. -->
	<key>WerewolfAppGroup</key>
	<string>group.cards.werewolf.msg</string>
	<key>NSExtension</key>
	<dict>
		<!-- A Messages extension is declared by its point identifier alone; the
		     principal class is what Messages instantiates. No storyboard: the UI
		     is SwiftUI hosted by the controller, so there is no .xib to keep in
		     step with it. -->
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.message-payload-provider</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).MessagesViewController</string>
	</dict>
</dict>
</plist>

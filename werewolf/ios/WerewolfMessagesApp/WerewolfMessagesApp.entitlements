<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The nickname this install claims. Regenerated from project.yml
	     `properties`, so it survives `xcodegen generate` rather than being
	     blanked by it. Inert on an unsigned simulator build. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.cards.werewolf.msg</string>
	</array>
</dict>
</plist>

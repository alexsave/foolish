<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Foolish</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Localizations shipped from day one (§5.5): en / ru / ko, plus
	     zh-Hans / vi added with the round-30 FStrings table. Chinese is
	     declared as zh-Hans (Simplified) and NOT zh-Hant, because the table
	     holds Simplified only; FStrings.systemDetected prefix-matches any
	     "zh" so a Traditional reader still lands on Simplified rather than
	     English, but the store must not advertise a script we do not
	     write. -->
	<!-- ROUND 46: fifteen languages, and every one of them has to be DECLARED
	     here or the phone will not offer it. FStrings resolves through
	     Locale.preferredLanguages, which the system filters by this list, so a
	     language the strings table carries but this array omits is a language
	     nobody can ever be served. That is not hypothetical - zh-Hans and vi
	     shipped translated and suppressed until they were added here. It is
	     also what the App Store product page lists. FStrings matches on the
	     PRIMARY SUBTAG, so zh-Hans satisfies "zh". -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>ko</string>
		<string>zh-Hans</string>
		<string>vi</string>
		<string>es</string>
		<string>pt</string>
		<string>fr</string>
		<string>de</string>
		<string>it</string>
		<string>ja</string>
		<string>pl</string>
		<string>uk</string>
		<string>tr</string>
		<string>id</string>
		<string>th</string>
		<string>nl</string>
		<string>sv</string>
		<string>da</string>
		<string>nb</string>
		<string>cs</string>
		<string>ro</string>
		<string>he</string>
		<string>ar</string>
		<string>fi</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Standard HTTPS only; no non-exempt encryption (§11). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Backend config, substituted from Config/*.xcconfig at build (§16.D1).
	     Blank in v1 offline builds; set for online play. -->
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SupabaseKey</key>
	<string>$(SUPABASE_KEY)</string>
	<!-- Dark-first identity (§5.1): the app forces its own dark palette. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- QR replay scanning (§16.C4). String required before review even though
	     the camera is only used on the Replays screen. -->
	<key>NSCameraUsageDescription</key>
	<string>Scan a replay QR code to watch a shared game.</string>
</dict>
</plist>

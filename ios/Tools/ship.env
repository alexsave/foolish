# The product block for shared/tools/ship/ship.sh (and shared/tools/devlogs.sh):
# Foolish's iMessage app, cards.foolish.msg. Ids, not secrets - the API key and
# the keychain password come from the environment. Paths are from the repo root.
#
#   ASC_KEY_ID=... ASC_ISSUER_ID=... SIGNING_KEYCHAIN_PASSWORD=... \
#     shared/tools/ship/ship.sh ios/Tools/ship.env [--build N] [--no-upload] [--dry-run]
#
# The scheme is FoolishMessagesApp, NEVER Foolish (that is the host app,
# cards.foolish.app, whose archive fails export with capability errors).
# project.yml spells CURRENT_PROJECT_VERSION twice (base + the watch target);
# ship.sh sets it on the archive command line, which overrides both.
SHIP_NAME=foolish
SHIP_APP_ID=6792255464
SHIP_BUNDLE=cards.foolish.msg
SHIP_EXT_BUNDLE=cards.foolish.msg.MessagesExtension
SHIP_TEAM=8N2Z544SB4
SHIP_APP_PROFILE="Foolish Msg Store 19"
SHIP_EXT_PROFILE="Foolish MsgExt Store 19"
SHIP_SCHEME=FoolishMessagesApp
SHIP_XCPROJ=ios/Foolish.xcodeproj
SHIP_KERNEL_DIR=c
SHIP_IOS_DIR=ios
SHIP_VERSION_FILE=ios/project.yml
SHIP_APP=FoolishMessagesApp.app
SHIP_APPEX=FoolishMessages.appex
# The store build IS signed with its own group (project.yml, the "19" profiles).
SHIP_APP_GROUP=group.cards.foolish.msg
SHIP_LOG_SUBSYSTEM=cards.foolish
SIGNING_KEYCHAIN="${SIGNING_KEYCHAIN:-$HOME/Library/Keychains/foolish-signing.keychain-db}"

# App Store Connect ids for Foolish's iMessage app (cards.foolish.msg) - the
# product block for shared/tools/asc/testflight.py, the way ship.env is
# shared/tools/ship/ship.sh's. Ids, not secrets: the API key lives in
# ~/.appstoreconnect and nowhere in the repo.
#
#   source ios/Tools/asc.env
#   shared/tools/asc/testflight.py status
#   shared/tools/ship/ship.sh ios/Tools/ship.env      # upload the next build
#   shared/tools/asc/testflight.py release -m "What to test"
export ASC_APP_ID=6792255464
export ASC_EXTERNAL_GROUP=d9377bc3-b4b0-4504-aebe-be378054ae34   # "Foolish iMessage Ext", public link
export ASC_INTERNAL_GROUP=92d2cee8-7455-47f7-a1f5-b94f91cb1d80   # "Foolish Cards for iMessage Testers"

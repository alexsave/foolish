#include "Base.xcconfig"

// Debug-only overrides. Point at a staging Supabase project for CI/dev so tests
// never touch prod (§16.D DoD: "do NOT point tests at prod").
// SUPABASE_URL = https://<staging-ref>.supabase.co
// SUPABASE_KEY = <staging-anon-key>

// Optional local override: if Config/Local.xcconfig exists (untracked), it points
// the Debug build at the local `supabase start` stack. Absent on CI → no-op.
#include? "Local.xcconfig"

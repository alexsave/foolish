<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The STANDALONE iMessage app: a codeless container whose only job is to
	     carry FoolishMessages.appex into the Messages app. It has no Home Screen
	     presence and no source files (a messages application never runs its own
	     UI) — everything the user sees comes from the extension.

	     Why this exists at all: an app extension cannot be distributed on its
	     own, so shipping the iMessage game without the host app requires a
	     container. This one links FoolishKit only, so it inherits no accounts,
	     no backend, and none of the host app's compliance surface. -->
	<key>CFBundleDisplayName</key>
	<string>Foolish</string>
	<key>CFBundleName</key>
	<string>Foolish</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Its own binary, so its own export-compliance declaration (the extension
	     carries a matching one). Standard TLS/crypto only.

	     Round-5 Q2: the FMSG payload path (chain ordering / parent linkage)
	     runs the payload through SHA-256 (c/src/sha256.c; swift-crypto is
	     linked) to get a digest to order and link chains by. That is hashing
	     for identity/ordering, not encryption — nothing on this path is ever
	     decrypted, because nothing on it is ever encrypted. `false` stands.
	     Revisit this key specifically if the FMSG path ever starts encrypting
	     payload bytes rather than just digesting them. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Round-5 Q1: tells the App Store the app presents more than English.
	     The actual localized strings are NOT in .lproj bundles yet -
	     FStrings.swift is the backing store, an in-code en/ru/ko/zh/vi table
	     that FStrings switches on at runtime from Locale.preferredLanguages.
	     Milestone E4's String Catalog will supersede this in-code table, but
	     this key is what the store listing needs regardless of where the
	     strings physically live.

	     zh-Hans / vi joined the table in round 30 and are declared here for
	     the first time. Chinese is zh-Hans (Simplified) and NOT zh-Hant: the
	     table holds Simplified only. FStrings.systemDetected prefix-matches
	     any "zh", so a Traditional reader still lands on Simplified rather
	     than English - but that is a fallback, not support, and the store
	     listing must not claim a script we do not write. -->
	<!-- ROUND 46: fifteen languages, and every one of them has to be DECLARED
	     here or the phone will not offer it. FStrings resolves through
	     Locale.preferredLanguages, which the system filters by this list, so a
	     language the strings table carries but this array omits is a language
	     nobody can ever be served. That is not hypothetical - zh-Hans and vi
	     shipped translated and suppressed until they were added here. It is
	     also what the App Store product page lists. FStrings matches on the
	     PRIMARY SUBTAG, so zh-Hans satisfies "zh". -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>ko</string>
		<string>zh-Hans</string>
		<string>vi</string>
		<string>es</string>
		<string>pt</string>
		<string>fr</string>
		<string>de</string>
		<string>it</string>
		<string>ja</string>
		<string>pl</string>
		<string>uk</string>
		<string>tr</string>
		<string>id</string>
	</array>
	<!-- Marks the bundle as a Messages-only application: no Home Screen icon,
	     discoverable in the Messages app drawer. -->
	<key>LSApplicationLaunchProhibited</key>
	<true/>
	<!-- Round-5 B4: UIRequiredDeviceCapabilities = [armv7] used to live here.
	     It survived only because this container is LSApplicationLaunchProhibited
	     and never launches, so the wrong capability never bit at runtime — but
	     App Store Connect validates metadata before anyone runs the binary, and
	     armv7 (32-bit) on an arm64-only app reads as "requires a device this
	     binary cannot run on" and fails upload. Deleting the key buys nothing
	     back (App Store Connect infers the real device capabilities from the
	     arm64 slice), so per the owner's call it is dropped entirely rather
	     than corrected to arm64. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

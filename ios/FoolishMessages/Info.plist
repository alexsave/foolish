<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Foolish</string>
	<key>CFBundleName</key>
	<string>Foolish</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- installd REFUSES an .appex without this ("missing or invalid
	     CFBundleExecutable"), and a hand-written plist does not get it for free —
	     Xcode only injects it into plists it generates. -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The .appex is a separate binary from the host app, so it needs its own
	     export-compliance declaration; Xcode does not inherit the app's. The
	     extension uses only Apple's standard TLS/crypto (App Group cache, no
	     bespoke encryption), so it is exempt like the host (Info.plist:31).

	     Round-5 Q2: this is also the binary that actually runs the FMSG
	     payload path — SHA-256 (c/src/sha256.c; swift-crypto is linked) over
	     the payload for chain ordering / parent linkage. That's a digest used
	     to order and link chains, not encryption of the payload, so `false`
	     is correct here too. If the FMSG path ever encrypts rather than
	     digests, this answer needs to be revisited. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Round-5 Q1: declares ru/ko presentation to the store. FStrings.swift
	     (in-code en/ru/ko table, switched at runtime on
	     Locale.preferredLanguages) is the backing store, not a .lproj — no
	     .lproj exists yet, and Milestone E4's String Catalog will supersede
	     this table. This key is what tells the App Store the app presents
	     Russian and Korean regardless of where the strings live. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>ko</string>
	</array>
	<!-- The App Group this extension's MessageGameStore uses. Read at runtime by
	     FoolishKit rather than hardcoded there, because FoolishKit is shared with
	     the host app, which owns a DIFFERENT group (group.cards.foolish). Must
	     match FoolishMessages.entitlements and the portal's App Group. -->
	<key>FoolishAppGroup</key>
	<string>group.cards.foolish.msg</string>
	<key>NSExtension</key>
	<dict>
		<!-- A Messages extension is declared by its point identifier alone; the
		     principal class is what Messages instantiates. No storyboard: the UI
		     is SwiftUI hosted by the controller (there is no .xib to keep in
		     step, and the drawer is built from FoolishKit's components). -->
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.message-payload-provider</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).MessagesViewController</string>
	</dict>
</dict>
</plist>
